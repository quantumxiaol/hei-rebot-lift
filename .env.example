# Copy to .env. The agent loads this file automatically; never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SEC=60
# Direct HTTPS by default; true allows HTTPX to use environment/macOS proxies.
DEEPSEEK_TRUST_ENV=false
DEEPSEEK_MAX_RETRIES=2
HEI_AGENT_SEND_IMAGES=true
